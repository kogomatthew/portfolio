---
import { certifications, education } from '../data/credentials';
---

<section class="section" id="credentials">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">Credentials</p>
      <h2 class="section-title">Certifications &amp; education</h2>
    </div>

    <div class="cert-band reveal">
      {
        certifications.map((c) => (
          <div class="cert-tile">
            <span class="cert-name">{c.name}</span>
            <span class="cert-issuer">
              {c.issuer}
              {c.date && ` · ${c.date}`}
            </span>
          </div>
        ))
      }
    </div>

    <ul class="degrees reveal">
      {
        education.map((e) => (
          <li class="degree">
            <div>
              <h3 class="degree-title">{e.degree}</h3>
              <p class="degree-school">{e.school}</p>
            </div>
            <span class="degree-date">{e.date}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cert-band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .cert-tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9rem;
    padding: 1.75rem;
    background-color: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 3px;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .cert-tile:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .cert-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--text);
  }

  .cert-issuer {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .degrees {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--border);
  }

  .degree {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .degree-title {
    font-size: 1.25rem;
  }

  .degree-school {
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .degree-date {
    font-weight: 500;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  @media (max-width: 900px) {
    .cert-band {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .cert-band {
      grid-template-columns: 1fr;
    }
  }
</style>
